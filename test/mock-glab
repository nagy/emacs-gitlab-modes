#!/usr/bin/env bash
# Offline stand-in for glab.  It reads the fixture directory from
# GITLAB_TEST_FIXTURE_DIR and never opens a network connection.
set -euo pipefail

fixture_dir="${GITLAB_TEST_FIXTURE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/fixtures}"
arguments="$*"

if [[ -n "${GITLAB_TEST_FAIL:-}" ]]; then
  printf '%s\n' "mock glab failure" >&2
  exit 1
fi

case "$arguments" in
  *"probe pwd"*) printf '{"pwd":"%s"}' "$PWD" ;;
  *"mr list"*) cat "$fixture_dir/mr-list.json" ;;
  *"mr view"*) cat "$fixture_dir/mr-view.json" ;;
  *"merge_requests/"*"/notes"*) cat "$fixture_dir/mr-notes.json" ;;
  *"ci list"*) cat "$fixture_dir/ci-list.json" ;;
  *"ci get"*)
    if [[ -n "${GITLAB_TEST_NO_JOBS:-}" ]]; then
      cat "$fixture_dir/ci-get-nojobs.json"
    else
      cat "$fixture_dir/ci-get.json"
    fi
    ;;
  *"pipelines/"*"/jobs"*) cat "$fixture_dir/pipeline-jobs.json" ;;
  *"ci trace"*) cat "$fixture_dir/job-trace.txt" ;;
  *)
    printf 'mock-glab: unknown arguments: %s\n' "$arguments" >&2
    exit 2
    ;;
esac
